      "language": "JAVASCRIPT",
      "title": "Count bits of every number",
      "intuition": "Count each number's 1 bits independently by stripping one bit at a time.",
      "approach": "For each i, repeatedly add n & 1 and shift n right until it is zero.",
      "pseudocode": "for i in 0..count: c = 0; n = i; while n > 0: c += n & 1; n >>= 1; out[i] = c",
      "code": "function litPanels(count) {\n  const result = [];\n  for (let i = 0; i <= count; i++) {\n    let n = i, lit = 0;\n    while (n > 0) { lit += n & 1; n >>= 1; }\n    result.push(lit);\n  }\n  return result;\n}",
      "timeComplexity": "O(n log n)",
      "spaceComplexity": "O(1) beyond the output",
