  "title": "Lit Panels",
  "difficulty": "EASY",
  "kind": "CODING",
  "status": "PUBLISHED",
  "pattern": "bit-counting",
  "statement": "A display board shows a number in binary, lighting one panel for every 1 bit. For every number from 0 through count, report how many panels are lit. Return an array of length count + 1 where entry i is the number of 1 bits in the binary form of i.",
  "constraints": [
    "0 <= count <= 10000"
  ],
  "estimatedMinutes": 15,
  "timeLimitMs": 2000,
  "memoryLimitKb": 262144,
  "categories": [
    "bit-manipulation",
    "dynamic-programming"
  ],
  "tags": [
    "bitwise",
    "state-transition"
  ],
  "interviewStyles": [
    "general-software"
  ],
  "relatedSlugs": [],
  "examples": [
    {
      "position": 1,
      "input": {
        "count": 5
      },
      "output": [
        0,
        1,
        1,
        2,
        1,
        2
      ],
      "explanation": "0 to 5 in binary are 0, 1, 10, 11, 100, 101, so the counts are 0, 1, 1, 2, 1, 2."
    },
    {
      "position": 2,
      "input": {
        "count": 0
      },
      "output": [
        0
      ],
      "explanation": "Only 0 is shown, with no lit panels."
    }
  ],
  "hints": [
    {
      "position": 1,
      "content": "You could count the bits of each number separately, but neighboring numbers share most of their bits."
    },
    {
      "position": 2,
      "content": "Shifting i right by one bit drops its last bit: i >> 1 has the same bits as i except the lowest one."
    },
    {
      "position": 3,
      "content": "So the count for i equals the count for i >> 1 plus whether i's last bit is 1."
    },
    {
      "position": 4,
      "content": "The last bit is i & 1. Because i >> 1 is smaller than i, its answer is already computed."
    },
    {
      "position": 5,
      "content": "Fill the array from 1 upward with bits[i] = bits[i >> 1] + (i & 1)."
    }
  ],
