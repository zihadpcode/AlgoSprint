      "approach": "Create bits[0] = 0 and for i from 1 to count set bits[i] = bits[i >> 1] + (i & 1).",
      "pseudocode": "bits[0] = 0; for i in 1..count: bits[i] = bits[i >> 1] + (i & 1); return bits",
      "code": "function litPanels(count) {\n  const bits = new Array(count + 1).fill(0);\n  for (let i = 1; i <= count; i++) bits[i] = bits[i >> 1] + (i & 1);\n  return bits;\n}",
      "timeComplexity": "O(n)",
