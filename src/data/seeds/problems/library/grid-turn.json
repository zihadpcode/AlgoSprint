      "code": "function gridTurn(matrix) {\n  const n = matrix.length;\n  const result = [];\n  for (let r = 0; r < n; r++) {\n    const row = [];\n    for (let c = 0; c < n; c++) row.push(matrix[n - 1 - c][r]);\n    result.push(row);\n  }\n  return result;\n}",
