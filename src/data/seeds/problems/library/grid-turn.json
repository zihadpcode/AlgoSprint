{
  "schemaVersion": 1,
  "slug": "grid-turn",
  "title": "Grid Turn",
  "difficulty": "MEDIUM",
  "kind": "CODING",
  "status": "PUBLISHED",
  "pattern": "matrix-transform",
  "statement": "A square pixel image is stored as matrix, a list of n rows of n integers. Return the image rotated 90 degrees clockwise, so the first row becomes the last column and the first column becomes the first row read from bottom to top. Do not modify the input; return a new matrix.",
  "constraints": [
    "1 <= n <= 100",
    "-1000000 <= matrix[r][c] <= 1000000"
  ],
  "estimatedMinutes": 20,
  "timeLimitMs": 2000,
  "memoryLimitKb": 262144,
  "categories": [
    "arrays",
    "math"
  ],
  "tags": [
    "simulation",
    "invariant"
  ],
  "interviewStyles": [
    "general-software"
  ],
  "relatedSlugs": [],
  "examples": [
    {
      "position": 1,
      "input": {
        "matrix": [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ],
          [
            7,
            8,
            9
          ]
        ]
      },
      "output": [
        [
          7,
          4,
          1
        ],
        [
          8,
          5,
          2
        ],
        [
          9,
          6,
          3
        ]
      ],
      "explanation": "The left column 7, 4, 1 (read upward) becomes the top row."
    },
    {
      "position": 2,
      "input": {
        "matrix": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      },
      "output": [
        [
          3,
          1
        ],
        [
          4,
          2
        ]
      ],
      "explanation": "A 2 × 2 rotation."
    }
  ],
  "hints": [
    {
      "position": 1,
      "content": "Track where one pixel goes: the pixel at row r, column c moves to row c, column n - 1 - r."
    },
    {
      "position": 2,
      "content": "Building a new matrix from that formula is straightforward."
    },
    {
      "position": 3,
      "content": "Rotation can also be done as two simpler moves."
    },
    {
      "position": 4,
      "content": "Transposing swaps matrix[r][c] with matrix[c][r] across the main diagonal."
    },
    {
      "position": 5,
      "content": "A transpose followed by reversing each row is a clockwise rotation. On a copy, that also shows how to rotate in place with O(1) extra memory."
    }
  ],
