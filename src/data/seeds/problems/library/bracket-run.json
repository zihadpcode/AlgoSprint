      "pseudocode": "for i: for j = i+2, i+4, ...: if valid(t[i..j)): best = max(best, j - i)",
      "code": "function bracketRun(text) {\n  const valid = (i, j) => {\n    let depth = 0;\n    for (let k = i; k < j; k++) {\n      depth += text[k] === '(' ? 1 : -1;\n      if (depth < 0) return false;\n    }\n    return depth === 0;\n  };\n  let best = 0;\n  for (let i = 0; i < text.length; i++)\n    for (let j = i + 2; j <= text.length; j += 2)\n      if (j - i > best && valid(i, j)) best = j - i;\n  return best;\n}",
