      "approach": "stack = [-1]. For '(' push i. For ')' pop; if the stack is empty push i as a new base, otherwise best = max(best, i - top).",
      "pseudocode": "stack = [-1]\nfor i: if t[i] == '(': push i\n  else: pop; if empty: push i else best = max(best, i - top)\nreturn best",
      "code": "function bracketRun(text) {\n  const stack = [-1];\n  let best = 0;\n  for (let i = 0; i < text.length; i++) {\n    if (text[i] === '(') stack.push(i);\n    else {\n      stack.pop();\n      if (stack.length === 0) stack.push(i);\n      else best = Math.max(best, i - stack[stack.length - 1]);\n    }\n  }\n  return best;\n}",
