  "hints": [
    {
      "position": 1,
      "content": "Each client is limited separately, so keep state per client."
    },
    {
      "position": 2,
      "content": "Only accepted requests count toward the limit."
    },
    {
      "position": 3,
      "content": "A request at time t only cares about the client's accepted times greater than t - window."
    },
    {
      "position": 4,
      "content": "Because times never go backwards, once an accepted time falls out of the window it never matters again."
    },
    {
      "position": 5,
      "content": "Keep a queue of accepted times per client; drop from the front while the oldest time is <= t - window, then accept if the queue has fewer than limit entries."
    }
  ],
