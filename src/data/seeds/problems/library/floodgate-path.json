  "title": "Floodgate Path",
  "difficulty": "HARD",
  "kind": "CODING",
  "status": "PUBLISHED",
  "pattern": "minimax-path",
  "statement": "A delta is mapped as a grid of ground heights. Rising water lets a boat travel between edge-adjacent cells (up, down, left, right) only once the water level is at least the height of every cell on its route. Return the lowest water level at which a boat can travel from the top-left cell to the bottom-right cell; that is, minimize the maximum height on the route, including both endpoints.",
  "constraints": [
    "1 <= rows, columns <= 50",
    "All rows have equal length",
    "0 <= grid[r][c] <= 1000000"
  ],
  "estimatedMinutes": 45,
  "timeLimitMs": 2000,
  "memoryLimitKb": 262144,
  "categories": [
    "graphs",
    "heaps",
    "binary-search"
  ],
  "tags": [
    "grid",
    "priority-queue"
  ],
  "interviewStyles": [
    "general-software"
  ],
