      "title": "Try each level with BFS",
      "intuition": "Raising the water only opens more cells, so test levels in increasing order until the destination is reachable.",
      "approach": "Sort the distinct heights. For each level at least the start's height, run BFS over cells with height <= level; return the first level that reaches the destination.",
      "pseudocode": "for level in sorted distinct heights: if start <= level and BFS(cells <= level) reaches end: return level",
      "code": "function floodgatePath(grid) {\n  const h = grid.length, w = grid[0].length;\n  const levels = [...new Set(grid.flat())].sort((a, b) => a - b);\n  for (const level of levels) {\n    if (grid[0][0] > level) continue;\n    const seen = new Set([0]), queue = [[0, 0]];\n    for (let q = 0; q < queue.length; q++) {\n      const [r, c] = queue[q];\n      for (const [dr, dc] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {\n        const nr = r + dr, nc = c + dc;\n        if (nr < 0 || nr >= h || nc < 0 || nc >= w || grid[nr][nc] > level || seen.has(nr * w + nc)) continue;\n        seen.add(nr * w + nc);\n        queue.push([nr, nc]);\n      }\n    }\n    if (seen.has((h - 1) * w + (w - 1))) return level;\n  }\n}",
