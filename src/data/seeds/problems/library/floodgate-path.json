  "hints": [
    {
      "position": 1,
      "content": "The cost of a route is its highest cell, not the sum of its cells."
    },
    {
      "position": 2,
      "content": "One approach: binary search the water level and check reachability with BFS at each level."
    },
    {
      "position": 3,
      "content": "Or adapt Dijkstra's algorithm: instead of adding costs, take the maximum along the route."
    },
    {
      "position": 4,
      "content": "Keep, for each cell, the lowest level known to reach it; always expand the cell with the lowest level next using a min-heap."
    },
    {
      "position": 5,
      "content": "The first time the destination is popped from the heap, its level is the answer."
    }
  ],
