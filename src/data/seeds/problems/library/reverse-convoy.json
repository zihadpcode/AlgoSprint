  "solutions": [
    {
      "kind": "BRUTE_FORCE",
      "language": "JAVASCRIPT",
      "title": "List the order, then relink",
      "intuition": "Write down the trucks in order, then point each one at its predecessor in that list.",
      "approach": "Collect the chain order in an array. Build new links where order[i] points to order[i - 1] and the old head points to -1. The new head is the last truck.",
      "pseudocode": "order = chain from head; links = all -1; for i from len-1 down to 1: links[order[i]] = order[i-1]; return [order[last], links]",
      "code": "function reverseConvoy(next, head) {\n  const order = [];\n  for (let truck = head; truck !== -1; truck = next[truck]) order.push(truck);\n  const links = new Array(next.length).fill(-1);\n  for (let i = order.length - 1; i > 0; i--) links[order[i]] = order[i - 1];\n  return [order[order.length - 1], links];\n}",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(n) for the order list",
      "commonMistakes": [
        "Forgetting that the old head must now point to -1."
      ],
      "interviewExplanation": "Materializing the order makes relinking trivial, at the cost of an O(n) helper array.",
      "steps": [
        {
          "position": 1,
          "title": "Step 1",
          "content": "Order for 0→1→2→3 is [0,1,2,3]."
        },
        {
          "position": 2,
          "title": "Step 2",
          "content": "Links: 3→2, 2→1, 1→0, 0→-1; head 3."
        }
      ]
    },
    {
      "kind": "OPTIMAL",
      "language": "JAVASCRIPT",
      "title": "Three-pointer reversal",
      "intuition": "Reversing one link at a time only needs to remember the previous truck and the truck after the current one.",
      "approach": "Copy the links. With previous = -1 and current = head: save after = links[current], set links[current] = previous, then advance previous = current and current = after. Return [previous, links].",
      "pseudocode": "prev = -1; cur = head\nwhile cur != -1: after = links[cur]; links[cur] = prev; prev = cur; cur = after\nreturn [prev, links]",
      "code": "function reverseConvoy(next, head) {\n  const links = [...next];\n  let previous = -1, current = head;\n  while (current !== -1) {\n    const after = links[current];\n    links[current] = previous;\n    previous = current;\n    current = after;\n  }\n  return [previous, links];\n}",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(1) beyond the copied links",
      "commonMistakes": [
        "Overwriting links[current] before saving the next truck.",
        "Returning head instead of previous as the new lead."
      ],
      "interviewExplanation": "This is the classic in-place reversal: one pass, three pointers, constant extra space. I copy next only because the input should not be mutated; with real node objects it would be fully in place. A recursive version is shorter but uses O(n) stack.",
      "steps": [
        {
          "position": 1,
          "title": "Step 1",
          "content": "prev -1, cur 0: link 0→-1; prev 0, cur 1."
        },
        {
          "position": 2,
          "title": "Step 2",
          "content": "link 1→0; link 2→1; link 3→2; cur becomes -1."
        },
        {
          "position": 3,
          "title": "Step 3",
          "content": "Return [3, [-1,0,1,2]]."
        }
      ]
    }
  ]
