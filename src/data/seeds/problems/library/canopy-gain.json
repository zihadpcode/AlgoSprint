    {
      "kind": "OPTIMAL",
      "language": "JAVASCRIPT",
      "title": "Post-order gains with a global best",
      "intuition": "The best trail bending at a node uses the best non-negative downward chain on each side, which a post-order pass computes for every node.",
      "approach": "gain(node) returns 0 for null; else left = max(0, gain(left)), right = max(0, gain(right)); update best with value + left + right; return value + max(left, right).",
      "pseudocode": "gain(n): if null: 0; l = max(0, gain(n.left)); r = max(0, gain(n.right)); best = max(best, n.v + l + r); return n.v + max(l, r)",
      "code": "function canopyGain(tree) {\n  const nodes = [];\n  const root = { value: tree[0], left: null, right: null };\n  nodes.push(root);\n  for (let i = 1, head = 0; i < tree.length; head++) {\n    const node = nodes[head];\n    if (tree[i] !== null) nodes.push(node.left = { value: tree[i], left: null, right: null });\n    i++;\n    if (i < tree.length && tree[i] !== null) nodes.push(node.right = { value: tree[i], left: null, right: null });\n    i++;\n  }\n  let best = -Infinity;\n  const gain = (node) => {\n    if (!node) return 0;\n    const left = Math.max(0, gain(node.left));\n    const right = Math.max(0, gain(node.right));\n    best = Math.max(best, node.value + left + right);\n    return node.value + Math.max(left, right);\n  };\n  gain(root);\n  return best;\n}",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(h) recursion",
      "commonMistakes": [
