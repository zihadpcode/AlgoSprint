{
  "schemaVersion": 1,
  "slug": "canopy-gain",
  "title": "Canopy Gain",
  "difficulty": "HARD",
  "kind": "CODING",
  "status": "PUBLISHED",
  "pattern": "tree-recursion",
  "statement": "A forest ranger scores each branch point of a tree by wildlife sightings, which may be negative when an area is damaged. The tree is given in level order (tree) with null for a missing child. A trail is any path that moves along branches without visiting a node twice; it may start and end anywhere and need not pass through the root. Return the largest total score of any trail with at least one node.",
  "constraints": [
    "1 <= number of nodes <= 10000",
    "-1000 <= value <= 1000"
  ],
  "estimatedMinutes": 45,
  "timeLimitMs": 2000,
  "memoryLimitKb": 262144,
  "categories": [
    "trees",
    "recursion",
    "dfs"
  ],
  "tags": [
    "recursion",
    "invariant"
  ],
  "interviewStyles": [
    "general-software"
  ],
  "relatedSlugs": [],
  "examples": [
    {
      "position": 1,
      "input": {
        "tree": [
          1,
          2,
          3
        ]
      },
      "output": 6,
      "explanation": "The trail 2 → 1 → 3 totals 6."
    },
    {
      "position": 2,
      "input": {
        "tree": [
          -10,
          9,
          20,
          null,
          null,
          15,
          7
        ]
      },
      "output": 42,
      "explanation": "15 → 20 → 7 totals 42; going through the root would only lower it."
    }
  ],
  "hints": [
    {
      "position": 1,
      "content": "Every trail has one highest node (closest to the root) where it bends."
    },
    {
      "position": 2,
      "content": "At that node, the trail is: the best downward chain from the left child, the node itself, and the best downward chain from the right child."
    },
    {
      "position": 3,
      "content": "A downward chain from a child is worth taking only if its total is positive."
    },
    {
      "position": 4,
      "content": "Write a post-order function that returns the best downward chain starting at a node: node.value + max(0, left chain, right chain)."
    },
    {
      "position": 5,
      "content": "While computing it, update a global best with node.value + max(0, left) + max(0, right)."
    }
  ],
