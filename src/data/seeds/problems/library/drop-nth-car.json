    }
  ],
  "hints": [
    {
      "position": 1,
      "content": "Counting the cars first and then walking to position length - k works in two passes."
    },
    {
      "position": 2,
      "content": "Can a single pass work if you keep two pointers a fixed distance apart?"
    },
    {
      "position": 3,
      "content": "Move a lead pointer k cars ahead of a trailing pointer."
    },
    {
      "position": 4,
      "content": "When the lead reaches the last car, the trailing pointer sits just before the car to remove."
    },
    {
      "position": 5,
      "content": "If the lead falls off the end after only k moves, the car to remove is the head itself."
    }
  ],
