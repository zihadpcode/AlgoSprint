  "title": "Drop the Nth Car",
  "difficulty": "MEDIUM",
  "kind": "CODING",
  "status": "PUBLISHED",
  "pattern": "fast-slow-pointers",
  "statement": "A train is a linked chain of cars: car i is followed by car next[i], or by nothing when next[i] is -1, and head is the first car. The chain visits every car exactly once. Uncouple the k-th car counting from the back (k = 1 is the last car) and reconnect the train. Return the car indices from front to back after the removal.",
  "constraints": [
    "1 <= next.length <= 10000",
    "0 <= head < next.length",
    "1 <= k <= next.length",
    "Following next from head visits every car exactly once and ends at -1"
  ],
  "estimatedMinutes": 25,
  "timeLimitMs": 2000,
  "memoryLimitKb": 262144,
  "categories": [
    "linked-list",
    "two-pointers"
  ],
  "tags": [
    "pointer-pair"
  ],
  "interviewStyles": [
    "general-software"
  ],
