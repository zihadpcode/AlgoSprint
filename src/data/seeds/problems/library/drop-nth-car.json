      "kind": "OPTIMAL",
      "language": "JAVASCRIPT",
      "title": "Lead and trail pointers",
      "intuition": "A gap of k cars between two pointers means that when the lead reaches the end, the trail is right before the target.",
      "approach": "Copy the links. Advance lead k times from head. If lead is -1, the head is removed. Otherwise move lead and trail together until lead is the last car, then bypass trail's next car. Read off the new order.",
      "pseudocode": "lead = head; repeat k: lead = next[lead]\nif lead == -1: head = next[head]\nelse: trail = head; while next[lead] != -1: lead, trail advance; next[trail] = next[next[trail]]\nreturn order from head",
      "code": "function dropNthCar(next, head, k) {\n  const links = [...next];\n  let lead = head;\n  for (let i = 0; i < k; i++) lead = links[lead];\n  if (lead === -1) head = links[head];\n  else {\n    let trail = head;\n    while (links[lead] !== -1) { lead = links[lead]; trail = links[trail]; }\n    links[trail] = links[links[trail]];\n  }\n  const order = [];\n  for (let car = head; car !== -1; car = links[car]) order.push(car);\n  return order;\n}",
      "timeComplexity": "O(n)",
